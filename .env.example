# Copy to .env.local for local development. On Railway, set these on the
# web service (Variables tab) in each project (staging, production).
# See README → Environment variables. Never commit real values.

# Postgres. On Railway use the reference variable ${{Postgres.DATABASE_URL}}
# so traffic stays on the private network.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/nectar_dev

# Secret salt for ip_hash = sha256(client IP + salt). Required.
# Generate one per environment: openssl rand -hex 32
IP_HASH_SALT=

# Resend (https://resend.com). Without RESEND_API_KEY and PILOT_FROM,
# requests are still stored but no email is sent.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Nectar pilot <pilot@nectarnetwork.fun>".
PILOT_FROM=
# Who gets the notification. Defaults to kunal@nectarnetwork.fun.
PILOT_NOTIFY_TO=kunal@nectarnetwork.fun

# Optional extra notification: each stored request is POSTed here as JSON.
# Leave empty to turn it off.
PILOT_WEBHOOK_URL=

# IndexNow (/api/indexnow). The Railway cron service sends CRON_SECRET as a
# bearer token. Set INDEXNOW_ENABLED=true in production once nectarnetwork.fun
# serves this site.
CRON_SECRET=
INDEXNOW_ENABLED=
# Cron service only: where to call, e.g.
# http://${{web.RAILWAY_PRIVATE_DOMAIN}}:${{web.PORT}}/api/indexnow
INDEXNOW_URL=

# Search engine verification tokens (read at build time; redeploy after changing).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Preview builds: SITE_NOINDEX=true keeps them out of search; CONTENT_PREVIEW=1 shows drafts.
SITE_NOINDEX=
CONTENT_PREVIEW=

# Tests only: a disposable database that `npm test` drops and recreates.
TEST_DATABASE_URL=
