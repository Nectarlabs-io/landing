{
  "name": "nectar-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "export:pilot": "node --env-file-if-exists=.env.local scripts/export-pilot.mjs"
  },
  "dependencies": {
    "hast-util-to-html": "^9.0.6",
    "mdast-util-to-string": "^4.0.0",
